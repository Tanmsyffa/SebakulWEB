# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Postgres Transaction Pooler (gunakan port 6543 untuk Vercel Serverless)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Resend Email API (untuk pengiriman tautan lupa kata sandi)
RESEND_API_KEY=re_your_resend_api_key
# Opsional: ganti setelah domain terverifikasi di Resend, mis. "SEBAKUL <noreply@domainanda.com>"
RESEND_FROM_EMAIL="SEBAKUL <onboarding@resend.dev>"
# Opsional: URL publik utama aplikasi (otomatis terdeteksi di Vercel jika dikosongkan)
NEXT_PUBLIC_SITE_URL=


# Supabase Auth & Storage
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Postgres Transaction Pooler (gunakan port 6543 untuk Vercel Serverless)
DATABASE_URL=postgresql://postgres.your-project-ref:your-db-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Resend Email API (untuk pengiriman tautan lupa kata sandi)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL="SEBAKUL <noreply@sebakul.my.id>"
# Opsional: URL publik utama aplikasi, mis. https://sebakul.my.id
NEXT_PUBLIC_SITE_URL=https://sebakul.my.id

# Cloudflare Turnstile CAPTCHA (opsional, aktif otomatis saat Site Key diisi)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

